# Generated by Cargo
# will have compiled files and executables
/debug
/target

# env
.env

# cargo-xwin cross-compilation cache (Windows SDK + CRT)
.xwin

# Pinned Khronos OpenXR loader, fetched + cached by scripts/fetch_openxr_loader.sh
.openxr

# JPEXS FFDec, fetched + cached by scripts/fetch_ffdec.sh. Only this subdirectory: the rest of
# vendor/ is committed code.
/vendor/ffdec/

# Generated FSR2 DX11 shader-permutation headers (regenerated by `cargo run -p shadergen`). The
# extracted headers are git-ignored; the compressed archive next to them IS committed, and fsr-sys's
# build.rs unpacks it when the headers are missing. See fsr-sys/README.md.
/fsr-sys/generated/dx11/
!/fsr-sys/generated/dx11.tar.gz

# These are backup files generated by rustfmt
**/*.rs.bk

# Python bytecode cache (tools/ scripts)
__pycache__/
*.pyc

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Personal settings files that earlier builds read from beside the payload DLL or the workspace
# root. Settings now live in the per-user configuration directory (see docs/mod/settings.md); the
# patterns stay so that copies left in a checkout are never committed.
body.local.json
controllers.local.json

# Synthetic tracking recordings, regenerated by `cargo run -p tracking-synth` (see
# docs/mod/testing/recorder.md). They run to a megabyte each, so they are not committed.
/testing/recordings/synthetic/
